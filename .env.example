# ════════════════════════════════════════════════════════════════
# FırsatPulsu — Ortam Değişkenleri (v13)
# ════════════════════════════════════════════════════════════════

# ── Telegram API (my.telegram.org) ──────────────────────────────
API_ID=0
API_HASH=
SESSION_STRING=
BOT_TOKEN=
CHANNEL_ID=@firsatpulsum
ADMIN_ID=

# ── Filtre eşikleri ─────────────────────────────────────────────
MIN_INDIRIM=20
MIN_KALITE=15
KUYRUK_BEKLEME=180
KUPON_MIN_TL=500
MARKA_SPAM_LIMIT=999

# ── Yeni özellik bayrakları ─────────────────────────────────────
QR_KOD_AKTIF=1
SPIKE_MODU_AKTIF=1
ESKI_MESAJ_LIMIT_DK=180
STOK_KONTROL_SAAT=6
MIN_GORSEL_BOYUT=400

# ── Sistem ──────────────────────────────────────────────────────
LOG_SEVIYE=INFO                # DEBUG, INFO, WARNING, ERROR, CRITICAL
PORT=8080                       # Health endpoint portu (Railway $PORT)
DATA_DIR=/data                  # SQLite DB ve backup'ların yeri

# ── Test modu ───────────────────────────────────────────────────
TEST_MODE=0

# ── Gemini Yapay Zeka (opsiyonel ama önerilen) ──────────────────
# Gerçek dil modeli ile ürün/reklam/kategori anlama.
# Boş bırakılırsa bot saf-Python yedek sistemini kullanır (yine çalışır).
# Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Kategori & kalite (sonraki sürümler) ────────────────────────
KATEGORI_GUVEN_ESIK=45          # Kategori güven eşiği
KALITE_PUAN_ESIK=0              # Kalite skoru filtresi (0=kapalı; skor yine kaydedilir, /karne)
DUPLICATE_GUN=3                 # Aynı ürünü tekrar paylaşmama penceresi (gün)

# ── İçerik filtreleri ───────────────────────────────────────────
KITAP_FILTRELE=1                # Kitapları paylaşma (Amazon ISBN linkleri). 0=kapat
ENGELLI_GONDERENLER=            # Engellenecek göndericiler, virgülle (örn: magfi,spamkanal)

# ── Tıklama takibi (opsiyonel) ──────────────────────────────────
TIKLAMA_TAKIP_AKTIF=0           # 1=aç. Affiliate tıklamalarını ölç
TIKLAMA_BASE_URL=               # Yönlendirme sunucusu adresi (örn: https://uygulamaniz.up.railway.app)
TIKLAMA_PORT=                   # Yönlendirme/health portu (boşsa PORT kullanılır)

# ── Kaynaklar katmanı (v23.37) — kanal yerine feed/mağaza ───────
KANAL_DINLE=1                   # 1=kanalları dinle. Feed'e geçince 0 yap
KAYNAK_TARAMA_AKTIF=0           # 1=feed/mağaza taramasını aç
KAYNAK_TARAMA_DK=30             # Tarama aralığı (dakika)
# Feed kaynağı (affiliate ağ / mağaza ortaklık feed'i):
FEED_URL=                       # Feed adresi (boşsa feed kapalı)
FEED_BICIM=xml                  # xml | csv | json
FEED_AD_ALAN=title              # Ürün adı alanı
FEED_FIYAT_ALAN=sale_price      # Güncel fiyat alanı
FEED_ESKIFIYAT_ALAN=price       # Eski/piyasa fiyatı alanı
FEED_URL_ALAN=link              # Ürün linki alanı
FEED_GORSEL_ALAN=image_link     # Görsel alanı
FEED_KATEGORI_ALAN=             # (ops) kategori alanı
FEED_MAGAZA_SABIT=              # (ops) sabit mağaza adı, ör: Trendyol
FEED_KAYIT_YOLU=                # XML: tekrar eden öğe (item); JSON: dizi yolu (data.products)
# Mağaza izleme (watchlist fiyat takibi):
MAGAZA_IZLEME_URL=              # İzlenecek ürün URL'leri, virgülle

# ── Lisans (v23.39) — satılan kopyalarda ────────────────────────
LISANS_DENETIMI=0               # 1=lisans zorunlu (alıcı için). Satıcı/dev: 0
LISANS_ANAHTARI=                # Alıcının lisans anahtarı (lisans_uret.py ile üretilir)
# LISANS_GIZLI=                 # Satıcı gizli anahtarı (GİZLİ; bot+üretici aynı olmalı)

# ── Web paneli (v23.40) ─────────────────────────────────────────
PANEL_SIFRE=                    # Panel parolası. BOŞSA panel herkese açık! Üretimde ayarlayın

# ── VDS / Caddy (HTTPS ters vekil) — yalnız docker-compose.vds.yml için ────
ALAN_ADI=                       # Botun alan adı, örn. bot.siteniz.com (DNS A kaydı VDS IP'sine)
CADDY_EMAIL=                    # Let's Encrypt bildirimleri için e-posta (opsiyonel)
# POSTGRES_PASSWORD=            # PostgreSQL'e geçince (POSTGRES_GECIS.md)
