# ════════════════════════════════════════════════════════════════
# FırsatPulsu — Ortam Değişkenleri
# Heroku → Settings → Config Vars bölümüne ekle
# ════════════════════════════════════════════════════════════════

# ── Telegram API (my.telegram.org) ──────────────────────────────
API_ID=0
API_HASH=

# ── Kullanıcı oturumu (Telethon StringSession) ──────────────────
SESSION_STRING=

ANTHROPIC_API_KEY=sk-ant-... (LLM fallback için, isteğe bağlı)


MARKA_SPAM_LIMIT=999

QR_KOD_AKTIF=1          # QR istemiyorsan 0
SPIKE_MODU_AKTIF=1
ESKI_MESAJ_LIMIT_DK=180
STOK_KONTROL_SAAT=6


# ── Bot token (opsiyonel – inline butonlar için @BotFather) ─────
BOT_TOKEN=

# ── Hedef kanal (örn. @firsatpulsum veya -100xxxxxxxxxx) ────────
CHANNEL_ID=@kacirmabak

# ── Admin Telegram user ID ──────────────────────────────────────
# ÖNEMLİ: Bu olmadan veri kalıcılığı (istatistik) çalışmaz.
# Kendi user ID'ni öğrenmek için @userinfobot'a /start yaz.
ADMIN_ID=1347898353

# ── Filtre eşikleri ─────────────────────────────────────────────
MIN_INDIRIM=20            # Bu oranın altındaki mesajlar atlanır (%)
MIN_KALITE=15             # Bu puanın altındaki mesajlar atlanır (0-100)
KUYRUK_BEKLEME=180        # Gönderimler arası bekleme (saniye)
KUPON_MIN_TL=500          # Bu TL'nin üstündeki kuponlar MIN_INDIRIM eşiğini bypass eder

# ── Test modu ───────────────────────────────────────────────────
TEST_MODE=0               # 1 yapınca 3 örnek fırsat gönderir
