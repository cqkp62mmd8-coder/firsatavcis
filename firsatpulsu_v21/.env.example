# ════════════════════════════════════════════════════════════════
# FırsatPulsu — Ortam Değişkenleri (v13)
# ════════════════════════════════════════════════════════════════

# ── Telegram API (my.telegram.org) ──────────────────────────────
API_ID=0
API_HASH=
SESSION_STRING=
BOT_TOKEN=
CHANNEL_ID=@firsatpulsum
ADMIN_ID=

# ── Filtre eşikleri ─────────────────────────────────────────────
MIN_INDIRIM=20
MIN_KALITE=15
KUYRUK_BEKLEME=180
KUPON_MIN_TL=500
MARKA_SPAM_LIMIT=999

# ── Yeni özellik bayrakları ─────────────────────────────────────
QR_KOD_AKTIF=1
SPIKE_MODU_AKTIF=1
ESKI_MESAJ_LIMIT_DK=180
STOK_KONTROL_SAAT=6
MIN_GORSEL_BOYUT=400

# ── Sistem ──────────────────────────────────────────────────────
LOG_SEVIYE=INFO                # DEBUG, INFO, WARNING, ERROR, CRITICAL
PORT=8080                       # Health endpoint portu (Railway $PORT)
DATA_DIR=/data                  # SQLite DB ve backup'ların yeri

# ── Test modu ───────────────────────────────────────────────────
TEST_MODE=0

# ── Gemini Yapay Zeka (opsiyonel ama önerilen) ──────────────────
# Gerçek dil modeli ile ürün/reklam/kategori anlama.
# Boş bırakılırsa bot saf-Python yedek sistemini kullanır (yine çalışır).
# Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
